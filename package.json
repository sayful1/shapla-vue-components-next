{
  "name": "@shapla/vue-components",
  "description": "A collection of reusable components for Vue 3.",
  "version": "1.5.3",
  "contributors": [
    {
      "name": "Sayful Islam",
      "email": "sayful.islam001@gmail.com",
      "url": "https://sayfulislam.com"
    }
  ],
  "keywords": [
    "vue",
    "vue-component",
    "modal",
    "notification"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sayful1/shapla-vue-components-next.git"
  },
  "bugs": {
    "url": "https://github.com/sayful1/shapla-vue-components-next/issues"
  },
  "unpkg": "./dist/components.umd.js",
  "main": "./dist/components.umd.js",
  "module": "./dist/components.mjs",
  "typings": "./dist/index.d.ts",
  "browser": {
    "./sfc": "./src/index.ts"
  },
  "files": [
    "dist/*",
    "src/*",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "install": "npm install --ignore-scripts esbuild",
    "install:docs": "npm i --no-save vue@3 vue-router@4 highlight.js",
    "dev": "vite",
    "build": "vite build && npm run build:dts",
    "build:dts": "vue-tsc --declaration --emitDeclarationOnly --declarationDir dist",
    "build:docs": "vue-tsc --noEmit && vite build --config vite-docs.config.ts",
    "test": "jest",
    "lint": "eslint --ext .js,.ts,.vue src",
    "format": "prettier . --write"
  },
  "peerDependencies": {
    "vue": "^3.0"
  },
  "dependencies": {
    "shapla-css": "^2.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-eslint": "^1.8.1",
    "vue-tsc": "^3.3.14"
  }
}
